---
import { content, locales, route, assets } from '../lib/copy.js';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/site.css';
const { lang, page='home' } = Astro.props;
const t=content[lang], navIds=['destinations','experience','locations'];
const languageNames={nl:'Nederlands',en:'English',fr:'Français'};
const title=page==='home' ? 'The Traveller — '+t.label : t.book+' · The Traveller';
---
<!doctype html>
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#141510"/><meta name="description" content={page === 'home' ? t.intro : t.demoNotice}/><link rel="icon" href={assets('favicon.svg')}/><title>{title}</title>
{locales.map(l=><link rel="alternate" hreflang={l} href={new URL(route(l,page),Astro.site)}/>)}
</head><body class={page}>
<a class="skip" href="#main">{t.skip}</a>
<header class="top"><div class="top-inner">
<a class="brand" href={route(lang)} aria-label={'The Traveller · '+t.home}><Mark/><span>The Traveller</span></a>
<nav class="desktop-nav" aria-label={t.menu}>{t.nav.map((n,i)=><a href={route(lang)+'#'+navIds[i]}>{n}</a>)}</nav>
<div class="nav-right"><details class="languages"><summary aria-label={t.lang}><Icon name="globe" size={16}/>{lang.toUpperCase()} <Icon name="chevron" size={13}/></summary><div class="dropdown">{locales.map(l=><a class="lang-link" aria-current={l===lang?'true':undefined} href={route(l,page)} hreflang={l} lang={l}>{languageNames[l]} {l===lang && <Icon name="check" size={15}/>}</a>)}</div></details>
<a class="nav-book" href={route(lang,'book')}>{t.book}<Icon name="diagonal" size={14}/></a>
<details class="mobile-menu"><summary aria-label={t.menu}><Icon name="menu"/></summary><nav class="dropdown">{t.nav.map((n,i)=><a href={route(lang)+'#'+navIds[i]}>{n}</a>)}<a href={route(lang,'book')}>{t.book}</a></nav></details></div>
</div></header>
<slot/>
<footer><div class="wrap foot-inner"><a class="brand" href={route(lang)}><Mark size={28}/><span>The Traveller</span></a><small>{t.demo}</small><a href={route(lang,'book')}>{t.book} <Icon name="diagonal" size={14}/></a></div></footer>
<script>
const menus = Array.from(document.querySelectorAll('header details'));
for (const menu of menus) {
  menu.addEventListener('toggle', () => { if (menu.open) menus.forEach(other=>{if(other!==menu) other.open=false;}); });
}
document.addEventListener('click', event => menus.forEach(menu=>{if (!menu.contains(event.target) || event.target.closest('a')) menu.open=false;}));
document.addEventListener('keydown', event=>{if(event.key==='Escape') for(const menu of menus) if(menu.open){menu.open=false;menu.querySelector('summary').focus();}});
document.querySelectorAll('.lang-link').forEach(link=>link.addEventListener('click',()=>{
  const url=new URL(link.href); url.search=location.search; url.hash=location.hash; link.href=url.href;
}));
</script>
</body></html>
