---
import {assets,worlds} from '../lib/copy.js';
const {names,label}=Astro.props;
// Adjacent destinations alternate between the three featured worlds and the other walks.
const faces=['amazon','glacier','sahara','bamboo','canyon','alps'];
---
<div class="pavilion-lift" aria-hidden="true">
  <div class="pavilion-camera">
    <div class="rigid-pavilion" role="img" aria-label={label}>
      <div class="prism-roof"><div class="roof-outline"></div></div>
      {faces.map((id,index)=><div class="prism-wall" style={'--side:'+index}>
        <div class="pane-frame"><div class="pane-window">
          <img src={assets(id+'.jpg')} alt="" decoding="async"/>
          <div class="pane-light"></div>
        </div></div>
        <div class="pane-name">{names[worlds.indexOf(id)]}</div>
      </div>)}
      <div class="prism-base"></div>
    </div>
  </div>
</div>
