---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Pavilion from './Pavilion.astro';
import {content,worlds,cities,route,assets} from '../lib/copy.js';
import {edition} from '../lib/edition.js';
import {photoCredits} from '../lib/photo-credits.js';
const {lang}=Astro.props, t=content[lang], e=edition[lang], booking=route(lang,'book');
const featured=['amazon','sahara','canyon'];
---
<Base lang={lang}><main id="main">
<section class="expedition" data-expedition aria-label="The Traveller">
  <div class="cinema">
    <div class="landscapes" aria-hidden="true">
      {['forest','sahara','canyon'].map((file,i)=><img src={assets(file+'.jpg')} class={'scenery scene-'+i} alt="" decoding="async" fetchpriority={i===0?'high':'auto'}/>)}
    </div>
    <div class="film-shade"></div>
    <div class="title-screen">
      <div class="opening-copy">
        <p class="series">{e.type}</p>
        <h1 class="masthead"><span>The</span><strong>Traveller</strong></h1>
        <p class="question">{t.title.join(' ')}</p>
        <a class="opening-link" href="#destinations">{e.enter}<Icon name="down" size={16}/></a>
      </div>
      <span class="origin">{e.cities}</span>
    </div>
    <Pavilion label={e.screen}/>
    <div class="scene-notes">
      {featured.map((id,i)=><article data-feature={i} hidden><p class="series">{t.regions[worlds.indexOf(id)]}</p><h2>{t.names[worlds.indexOf(id)]}</h2><p>{e.scenes[i]}</p><a href={booking+'?world='+id}>{t.pick} <Icon name="diagonal" size={14}/></a></article>)}
    </div>
    <div class="cinema-exit" aria-hidden="true"></div>
  </div>
  <span class="scene-anchor" id="destinations" aria-hidden="true"></span>
  <span class="scene-anchor" id="amazon" aria-hidden="true"></span><span class="scene-anchor" id="sahara" aria-hidden="true"></span><span class="scene-anchor" id="canyon" aria-hidden="true"></span>
</section>
<noscript><style is:inline>.expedition{height:auto}.cinema{position:relative}.opening-link{display:none}</style></noscript>
<section id="experience" class="inside-exp wrap">
  <div class="experience-picture"><img src={assets('interior.jpg')} loading="lazy" alt={t.steps[1][1]}/></div>
  <div class="inside-copy"><p class="series">{t.experience}</p><h2>{e.inside}</h2><p>{e.intro}</p><a class="outline-action" href={booking}>{e.all}<Icon name="diagonal" size={15}/></a></div>
</section>
<section id="locations" class="locations-band"><div class="wrap location-layout"><div><h2>{e.visit}</h2><p>{e.visitText}</p><p class="rates">30 min / €13 <span>·</span> 60 min / €22</p></div><div class="city-list">{cities.map((city,i)=><a href={booking+'?city='+city} aria-label={t.cityLink+' '+t.citiesLabel[i]}>{t.citiesLabel[i]}<Icon name="diagonal" size={22}/></a>)}</div></div></section>
<details class="credits wrap" id="photography"><summary>{e.photos}</summary><ul>{photoCredits.map(c=><li><b>{c.place}</b> · <a href={c.source}>{c.author}</a> · <a href={c.licenseUrl}>{c.license}</a></li>)}</ul><small>{({nl:'Uitsnedes en verkleinde beelden van de originele foto’s.',en:'Photographs cropped and resized from the originals.',fr:'Photographies recadrées et redimensionnées.'})[lang]}</small></details>
<script>import '../lib/home.js';</script></main></Base>
