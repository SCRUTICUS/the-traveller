---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import {content,worlds,cities,prices,assets,route} from '../lib/copy.js';
const {lang}=Astro.props,t=content[lang];
---
<Base lang={lang} page="book"><main class="wrap book-main" id="main">
<a class="back" href={route(lang)}><Icon name="left" size={14}/>{t.back}</a>
<div data-booking>
<h1>{t.booking} <em>{t.bookingEm}</em></h1><p class="book-lead">{t.one} {t.demoNotice}</p>
<div class="book-grid"><form id="book-form">
<fieldset><legend>{t.destination}</legend><div class="dest-inputs">{worlds.map((w,i)=><label class="dest-option"><input type="radio" name="world" value={w} checked={i===0}/><img src={assets(w+'.jpg')} alt=""/><span>{t.names[i]}</span></label>)}</div></fieldset>
<fieldset><legend>{t.city}</legend><div class="choices">{cities.map((city,i)=><label><input type="radio" name="city" value={city} checked={i===0}/><span>{t.citiesLabel[i]}</span></label>)}</div></fieldset>
<fieldset><legend>{t.duration}</legend><div class="choices duration">{Object.entries(prices).map(([d,p],i)=><label><input type="radio" name="duration" value={d} checked={i===0}/><span>{d} {t.min}<b>€{p}</b></span></label>)}</div></fieldset>
<div class="date-time"><label>{t.day}<input type="date" name="date" required/></label><label>{t.time}<select name="time" required>{['10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00'].map(time=><option value={time}>{time}</option>)}</select></label></div>
</form><aside class="booking-summary"><img data-preview alt=""/><div class="summary-body"><div class="eyebrow"><i></i>{t.summary}</div><h2 data-world></h2><dl><div><dt>{t.city}</dt><dd data-city></dd></div><div><dt>{t.duration}</dt><dd data-duration></dd></div><div><dt>{t.day}</dt><dd data-day></dd></div><div><dt>{t.time}</dt><dd data-time></dd></div><div class="total"><dt>{t.total}</dt><dd data-price></dd></div></dl><button class="pill primary" form="book-form" type="submit">{t.confirm}<Icon name="diagonal" size={16}/></button></div></aside></div></div>
<section class="ticket-section" data-ticket hidden><div class="eyebrow"><i></i>{t.ticket}</div><h1 tabindex="-1" data-ticket-title>{t.ticketTitle}</h1><p>{t.demoTicket}</p><article class="ticket"><img data-preview alt={t.ticketAlt}/><div class="ticket-info"><div class="brand"><Mark size={27}/>The Traveller</div><h2 data-world></h2><dl><div><dt>{t.city}</dt><dd data-city></dd></div><div><dt>{t.duration}</dt><dd data-duration></dd></div><div><dt>{t.day}</dt><dd data-day></dd></div><div><dt>{t.time}</dt><dd data-time></dd></div><div><dt>{t.total}</dt><dd data-price></dd></div></dl></div></article><button class="pill ghost" type="button" data-edit>{t.change}<Icon name="right" size={16}/></button></section>
<script id="booking-config" type="application/json" set:html={JSON.stringify({worlds,cities,prices,names:t.names,cityNames:t.citiesLabel,locale:t.locale,min:t.min,images:worlds.map(w=>assets(w+'.jpg'))})}/>
<script>import '../lib/booking.js';</script>
</main></Base>
